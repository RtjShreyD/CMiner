# Example environment variables for CMiner/OpenClaw news pipeline
# Rename this file to .env and fill in values.

# OpenAI/Gemini API key used by the newsAligator pipeline and optional fallback models.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Instagram upload pipeline keys (if enabled in your workflow)
UPLOAD_POST_KEY=your-upload-post-api-key-here
UPLOAD_POST_USER=your-upload-post-username-here

# Optional: set the path to your OpenClaw CLI binary if not on PATH.
#OPENCLAW_BIN=/path/to/openclaw
